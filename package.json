{
  "name": "dot2dot-js",
  "version": "0.1.0",
  "description": "Container-relative SVG router for connecting ordered anchor points.",
  "type": "module",
  "main": "./dist/dot2dot.umd.js",
  "module": "./dist/dot2dot.esm.js",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/dot2dot.esm.js",
      "default": "./dist/dot2dot.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/emit-types.mjs",
    "dev": "vite build --watch",
    "release:patch": "node scripts/release-version.mjs",
    "release:version": "node scripts/release-version.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "svg",
    "routing",
    "webflow",
    "connectors"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.8.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
